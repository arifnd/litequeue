{
    "name": "arifnd/litequeue",
    "description": "A lightweight queue core for Laravel, compatible with Laravel Queue and Horizon.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "queue",
        "horizon",
        "redis",
        "worker",
        "jobs"
    ],
    "authors": [
        {
            "name": "arifnd"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/container": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "illuminate/filesystem": "^11.0 || ^12.0 || ^13.0",
        "illuminate/pipeline": "^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.0 || ^12.0 || ^13.0",
        "illuminate/redis": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Arifnd\\LiteQueue\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Arifnd\\LiteQueue\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/lq"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arifnd\\LiteQueue\\LiteQueueServiceProvider"
            ],
            "aliases": {
                "LiteQueue": "Arifnd\\LiteQueue\\Facades\\LiteQueue"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "check": [
            "@format -- --test",
            "@analyse",
            "@test"
        ]
    },
    "suggest": {
        "laravel/horizon": "Required only to view LiteQueue as a supervisor in a Horizon dashboard.",
        "predis/predis": "Alternative Redis client when the phpredis extension is unavailable."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
